# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Langfuse tracing (default). MIT-licensed and self-hostable — preferred over
# LangSmith so traces stay on our infrastructure without an Enterprise plan.
# Cloud: https://cloud.langfuse.com  Self-host: http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_BASE_URL is accepted as an alias of LANGFUSE_HOST.
# LANGFUSE_ENABLED=false

# MLflow tracing (alternative). Used when Langfuse keys are unset and this URI
# is set. Experiment-platform / model-registry teams already running MLflow
# should use this instead of adding a second LLM-ops product.
# Host CLI: http://localhost:5000
# Compose graph: http://mlflow:5000  (docker compose --profile mlflow up)
# File store without a server: file:./mlruns
# MLFLOW_TRACKING_URI=
# MLFLOW_EXPERIMENT_NAME=agent-team
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=
# MLFLOW_TRACKING_TOKEN=
# MLFLOW_ENABLED=false

# LangSmith tracing (alternative). Used only when Langfuse keys and
# MLFLOW_TRACKING_URI are unset.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=multi-agent-slack-pipeline
# Legacy aliases still accepted by LangChain:
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=multi-agent-slack-pipeline

# LangGraph Server (used by the Slack gateway and evals)
LANGGRAPH_SERVER_URL=http://localhost:8123
LANGGRAPH_ASSISTANT_ID=agent_team

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL=#agent-approvals
SLACK_ENABLED=false
# Official Slack. Point at the emulator for local HITL without a workspace:
# SLACK_API_BASE_URL=http://localhost:8081/api/
SLACK_API_BASE_URL=https://slack.com/api/
SLACK_INTERACTIVITY_URL=http://localhost:8080/slack/interactive
# Compose network (profile slack-emulator):
# SLACK_COMPOSE_API_BASE_URL=http://slack-emulator:8081/api/
# SLACK_INTERACTIVITY_URL_COMPOSE=http://slack-gateway:8080/slack/interactive
# SLACK_EMULATOR_PORT=8081
# SLACK_EMULATOR_AUTO_APPROVE=true
# SLACK_EMULATOR_APPROVE_DELAY_SECONDS=0.4

# NATS JetStream
# Outbound: graph -> agent.review.required -> slack-publisher
# Inbound:  slack-gateway -> agent.review.feedback -> workflow-resumer
NATS_ENABLED=false
NATS_URL=nats://localhost:4222
NATS_STREAM=AGENT_REVIEW
NATS_SUBJECT=agent.review.required
# Worker queue / deliver group. Every slack-publisher instance must use the same value.
NATS_QUEUE=slack-publisher
NATS_FEEDBACK_SUBJECT=agent.review.feedback
NATS_FEEDBACK_QUEUE=workflow-resumer

# Human-in-the-loop
# Set true in evals / CI so the graph does not pause for review.
AUTO_APPROVE=false
MAX_SUPERVISOR_STEPS=12

# Slack gateway
SLACK_GATEWAY_HOST=0.0.0.0
SLACK_GATEWAY_PORT=8080

# OpenTelemetry (Slack gateway + NATS workers)
# Apps never hardcode a collector host. Set the endpoint for *this* process:
#   Compose network:  http://otel-collector:4318   (compose default if unset)
#   Host process:     http://localhost:4318
#   Remote / vendor:  https://otlp.example.com
# OTEL_SDK_DISABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=
# Compose network (does not reuse host localhost URLs):
# OTEL_COMPOSE_OTLP_ENDPOINT=http://otel-collector:4318
# NATS_COMPOSE_URL=nats://nats:4222
# LANGGRAPH_COMPOSE_URL=http://langgraph-api:8000
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local,service.namespace=agent-team
# Per-process names (compose sets these; override when processes run elsewhere)
# OTEL_SERVICE_NAME=
# OTEL_SERVICE_NAME_SLACK_GATEWAY=slack-gateway
# OTEL_SERVICE_NAME_SLACK_PUBLISHER=slack-publisher
# OTEL_SERVICE_NAME_WORKFLOW_RESUMER=workflow-resumer
# Collector → next hop (Jaeger in compose, or any OTLP backend)
# OTEL_COLLECTOR_FORWARD_ENDPOINT=jaeger:4317
# OTEL_COLLECTOR_FORWARD_INSECURE=true
# OTEL_COLLECTOR_FORWARD_AUTH=
# OTEL_COLLECTOR_OTLP_HTTP_PORT=4318
# OTEL_COLLECTOR_OTLP_GRPC_PORT=4317
# JAEGER_UI_PORT=16686
# OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.122.1
# JAEGER_IMAGE=jaegertracing/all-in-one:1.68.0

# Postgres / Redis (docker compose / LangGraph Platform)
POSTGRES_USER=langgraph
POSTGRES_PASSWORD=changeme
POSTGRES_DB=langgraph
DATABASE_URI=postgresql://langgraph:changeme@postgres:5432/langgraph?sslmode=disable
REDIS_URI=redis://redis:6379
